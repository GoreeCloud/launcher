<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="150dp"
    android:layout_height="142dp"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="6dp"
    android:background="@drawable/bg_edit_mode_page_strip_item"
    android:orientation="vertical"
    android:padding="6dp">

    <ImageView
        android:id="@+id/page_strip_preview"
        android:layout_width="match_parent"
        android:layout_height="82dp"
        android:background="#EFF5FC"
        android:contentDescription="Home page preview"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/page_strip_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="12sp" />
        <ImageButton
            android:id="@+id/page_strip_home_button"
            android:layout_width="36dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/edit_mode_page_strip_set_home"
            android:padding="7dp"
            android:src="@drawable/ic_home_pin"
            android:tint="@color/edit_mode_page_strip_home_tint" />
        <ImageButton
            android:id="@+id/page_strip_remove_button"
            android:layout_width="36dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="Remove empty Home page"
            android:padding="7dp"
            android:src="@android:drawable/ic_menu_delete"/>
    </LinearLayout>
</LinearLayout>
